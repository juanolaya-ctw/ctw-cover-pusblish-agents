# --- Notion ---
NOTION_TOKEN=secret_xxx
# Data source ID from metricool-discover (Notion API 2025-09-03; was "database" id)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides (defaults match Parrilla CTW)
NOTION_PROP_STATUS=Estado de la publicación
NOTION_PROP_PUBLICATION=Publicación
NOTION_PROP_CHANNEL=Canal 
NOTION_PROP_CAPTION=Caption
NOTION_PROP_FINAL_FILE=Archivo Final
NOTION_PROP_TITLE=Titulo de la publicación 
# Hook drawn on the Instagram reel cover. Not the publication title.
NOTION_PROP_COVER_TEXT=Titulo
NOTION_PROP_CONTENT_TYPE=Tipo de contenido 
NOTION_PROP_MINIATURA=Miniatura
NOTION_PROP_PROTAGONISTA=Protagonista
NOTION_STATUS_APPROVED=Aprobado - Edición Final
NOTION_STATUS_SCHEDULED=Programado
NOTION_STATUS_PUBLISHED=Publicado

# --- Metricool (Colombia Tech) ---
METRICOOL_USER_TOKEN=your_x_mc_auth_token
METRICOOL_USER_ID=0000000
METRICOOL_BLOG_ID=5822365
METRICOOL_TIMEZONE=America/Bogota
METRICOOL_BASE_URL=https://app.metricool.com/api

# --- Jobs ---
# Keep false in .env; use --enable for one-off live runs, or set true for cron
ENABLE_SCHEDULE=false
TIMEZONE=America/Bogota

# Schedule job limits
# Counts successful creates only. Skipped, past, duplicate, and no-media rows do not consume a slot.
SCHEDULE_MAX_PER_RUN=5
# Comma-separated Canal values skipped by schedule.
# Newsletter stays manual. IG Nico is Nicolás's brand and is never scheduled here
# (also enforced in code, together with Newsletter).
# Any Canal that is only LinkedIn (LinkedIn, LinkedIn Majo, LinkedIn CT, …) is
# always excluded. A multi-network row drops LinkedIn and keeps the other network.
# Do not point METRICOOL_BLOG_ID at 7255578 or 7272512 (other brands). Colombia Tech is 5822365.
SCHEDULE_EXCLUDE_CHANNELS=Newsletter,IG Nico
# Optional. When these Notion properties hold the Metricool post id/uuid,
# sync_dates matches on them before caption/title. Leave empty if the parrilla has no such column.
# NOTION_PROP_METRICOOL_ID=
# NOTION_PROP_METRICOOL_UUID=

# confirm_published / sync_dates
CONFIRM_MAX_PER_RUN=20
SYNC_DATES_MAX_PER_RUN=20
PUBLICATION_WINDOW_DAYS=7

# --- Media / ffmpeg ---
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
INSTAGRAM_VIDEO_MAX_WIDTH=1920
MEDIA_WORK_DIR=.data/media-work
# Google Drive: required for Archivo Final *folder* links; also used to download
# Drive *file* bytes via API (alt=media). Share folders/files with the SA email.
# Without this, private Drive files hit uc?export=download HTML and fail.
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
# Every image, video, and reel cover is uploaded to Metricool planner storage
# (PUT/PATCH /v2/media/s3/upload-transactions). The post stores convertedFileUrl
# on https://static.metricool.com. External and temporary hosts are not used.
# Dropbox folder links (/scl/fo/ or /sh/) are listed with the refresh token below
# and each file is downloaded by id (id:...), never by path and never via
# files/get_temporary_link. sharing.write is not required.
# TRANSFER_SH / S3_* are ignored for hosting (kept so older env files still parse).
TRANSFER_SH=false
# TRANSFER_SH_ENABLED=false
TRANSFER_SH_URL=https://transfer.sh
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
# Optional: pin build label in logs (otherwise BUILD.txt / git SHA / version)
# METRICOOL_SYNC_BUILD=
# Optional bundled ffmpeg if system ffmpeg is missing: pip install "metricool-sync-posts[ffmpeg]"
# Or Windows: winget install --id Gyan.FFmpeg -e


# --- Slack (optional) ---
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#ct-growth
SLACK_DEDUPE_HOURS=6
SLACK_DEDUPE_FILE=.data/slack-dedupe.json

# --- ctw-cover-agent (Instagram REEL / TRIAL_REEL covers) ---
# Archivo Final still accepts Dropbox share links and Drive. Bytes are uploaded
# to Metricool. A folder link is listed with the refresh token below (same app
# as the cover agent). sharing.write is not required. The reel cover is
# cover-final.png converted to JPEG and stored as videoThumbnailUrl.
# CTW_COVER_AGENT_PATH=/workspace/ctw-cover-agent
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# DROPBOX_REFRESH_TOKEN=
# DROPBOX_REFRESH_TOKEN_FILE=/home/box/.secrets/dropbox_refresh_token
# DROPBOX_ACCESS_TOKEN=   # optional; forwarded only if the cover agent still accepts it
# IG reels are not scheduled without a cover. Set false to allow a reel with no thumbnail.
REQUIRE_COVER_FOR_SCHEDULE=true

# --- Runtime ---
DRY_RUN=false
LOG_LEVEL=INFO
